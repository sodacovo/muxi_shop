[uwsgi]

env = DJANGO_SETTINGS_MODULE=muxi_shop_api2.settings.settings_dev

# 1. 项目根目录
chdir=/home/tarena/muxi_shop/muxi_shop_api2/
# 2. WSGI入口
module=muxi_shop_api2.wsgi:application
master=True
# 3. pid文件路径
pidfile=/home/tarena/muxi_shop/muxi_shop_api2/project-master.pid
vacuum=True
max-requests=5000
# 4. 日志文件路径
daemonize=/home/tarena/muxi_shop/muxi_shop_api2/log/uwsgi/muxishop.log

# 5. 静态文件映射
static-map=/static/product_images=/home/tarena/muxi_shop/muxi_shop_api2/static/product_images

home = /home/tarena/muxi_shop/muxi_shop_api2/.venv

http = 0.0.0.0:8000